# =========================================================================
# DEPLOYMENT
# =========================================================================
COMPOSE_PROJECT_NAME=identify-voice

# Images được CI push lên Docker Hub.
# CI hiện tạo tag "latest" và "sha-<short-commit>".
BACKEND_IMAGE=docker.io/your-dockerhub-user/identify-voice-backend
CLIENT_IMAGE=docker.io/your-dockerhub-user/identify-voice-client
IMAGE_TAG=sha-0123456

# =========================================================================
# RUNTIME
# =========================================================================
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh
PORT=3000
CLIENT_PORT=8080
CLIENT_API_BASE_URL=/api/v1
APP_NAME="Identify Voice API"
APP_VERSION=1.0.0
BACKEND_URL=https://your-domain.example

# =========================================================================
# AUTHENTICATION
# =========================================================================
JWT_ACCESS_SECRET=replace-with-a-strong-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=replace-with-a-strong-random-legacy-secret
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# =========================================================================
# STORAGE
# =========================================================================
STORAGE_DRIVER=local

# Phải khớp volume voice_storage:/app/storage trong docker-compose.prod.yml.
STORAGE_ROOT_DIR=/app/storage
STORAGE_PUBLIC_DIR=public
STORAGE_PRIVATE_DIR=private
STORAGE_TEMP_DIR=temp
STORAGE_CDN_URL=https://your-domain.example/cdn
STORAGE_ALLOWED_MIMES=audio/wav,audio/vnd.wave,audio/wave,audio/x-wav,audio/mpeg,audio/mp3,audio/mp4,video/mp4,audio/x-m4a,audio/flac,audio/x-flac,audio/ogg,audio/webm
STORAGE_MAX_SIZE=52428800
API_BODY_LIMIT=50mb

# =========================================================================
# POSTGRESQL
# =========================================================================
DB_USER=identify_voice
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=voice_db
DB_SCHEMA=public

# Chỉ mở trong mạng tin cậy hoặc giới hạn bằng firewall.
DB_PUBLIC_PORT=5432
PRISMA_STUDIO_PORT=5555

# =========================================================================
# REDIS
# =========================================================================
REDIS_PASSWORD=replace-with-a-strong-redis-password

# =========================================================================
# EXTERNAL SERVICES
# =========================================================================

# AI Core phải truy cập được từ container backend và worker.
AI_CORE_IDENTIFY_URL=https://ai-identify.your-domain.example
AI_CORE_OCR_URL=https://ai-ocr.your-domain.example
AI_CORE_OCR_PDF_BATCH_SIZE=3
AI_CORE_SPEECH_TO_TEXT_URL=https://ai-s2t.your-domain.example
AI_CORE_FILTER_NOISE_URL=https://ai-filter.your-domain.example/filter_noise/filter_noise_segment
AI_CORE_TRANSLATION_URL=https://ai-translation.your-domain.example
AI_CORE_TRANSLATION_CHUNK_WORD_LIMIT=1000
AI_CORE_TRANSLATION_CHUNK_CHARACTER_LIMIT=1200
AI_SERVICE_TIMEOUT=120000
AUDIO_NORMALIZE_TIMEOUT_MS=15000

# SMTP hiện là thành phần tùy chọn, nhưng config validation yêu cầu giá trị.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@your-domain.example
EMAIL_FROM="Identify Voice <no-reply@your-domain.example>"
EMAIL_TEMPLATES_PATH=src/module/email/templates

# Google OAuth chưa thuộc runtime chính. Chỉ cấu hình khi chức năng được bật.
GOOGLE_CLIENT_ID=replace-when-google-oauth-is-enabled
GOOGLE_CLIENT_SECRET=replace-when-google-oauth-is-enabled
GOOGLE_REDIRECT_URI=https://your-domain.example/api/v1/auth/google/callback

# =========================================================================
# NETWORK AND COOKIE
# =========================================================================
CORS_ORIGINS=https://your-domain.example
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
COOKIE_DOMAIN=your-domain.example
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_MAX_AGE=604800000
COOKIE_PATH=/

# =========================================================================
# LOGGING AND OPTIONAL MONITORING FLAGS
# =========================================================================
LOG_LEVEL=info
FILE_LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14

# Các cờ này được giữ cho cấu hình tương lai; metrics/health chưa được triển khai.
PROMETHEUS_ENABLED=false
METRICS_PORT=9090
HEALTH_ENDPOINTS_ENABLED=false
